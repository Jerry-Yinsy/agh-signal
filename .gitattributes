# 统一换行，避免 Windows 与 Linux 之间反复出现"整文件被改"的 diff
* text=auto

*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

*.mjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.docx binary
*.zip binary
